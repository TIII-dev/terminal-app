{
  "name": "tiii-terminal-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "ng serve",
    "build:windows": "tauri build --bundles nsis,msi -- --locked && bun scripts/copy-bundles/copy-bundles.ts",
    "build:macos": "tauri build --bundles app,dmg -- --locked && bun scripts/copy-bundles/copy-bundles.ts",
    "build:linux": "tauri build --bundles deb,rpm,appimage -- --locked && bun scripts/copy-bundles/copy-bundles.ts",
    "build:last-tag": "bun scripts/build-last-tagged-version/build-last-tagged-version.ts",
    "publish:last-tag": "bun scripts/publish-last-tagged-version/publish-last-tagged-version.ts",
    "release:patch": "gith release --patch --update-version --npm",
    "release:minor": "gith release --minor --update-version --npm",
    "release:major": "gith release --major --update-version --npm",
    "version": "bun scripts/release/release.version.ts",
    "install:linux": "bash scripts/install-linux.sh",
    "test": "bun test src scripts",
    "prepare": "git config core.hooksPath .githooks",
    "build": "ng build",
    "typecheck": "tsc --noEmit --project tsconfig.app.json && tsc --project tsconfig.scripts.json",
    "lint": "bun run lint:ts && bun run lint:css && bun run lint:rs",
    "lint:ts": "bun fmt --check --single-quote \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "lint:css": "bun fmt --check \"src/**/*.css\"",
    "lint:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "fix": "bun run fix:ts && bun run fix:css && bun run fix:rs",
    "fix:ts": "bun fmt --single-quote \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "fix:css": "bun fmt \"src/**/*.css\"",
    "fix:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "dev:tauri": "tauri dev"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@tauri-apps/cli": "^2.0.0",
    "@tertium/gith": "^0.5.0",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "typescript": "~6.0.0"
  },
  "description": "A compact terminal that keeps your shells organized and your workspace your own.",
  "author": {
    "name": "TIII",
    "url": "https://github.com/TIII-dev"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TIII-dev/terminal-app.git"
  },
  "homepage": "https://github.com/TIII-dev/terminal-app#readme",
  "keywords": [
    "terminal",
    "shell",
    "desktop"
  ]
}
