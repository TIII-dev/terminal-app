{
  "name": "tiii-terminal-app",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "^22.22.3 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "dev": "ng serve",
    "build:windows": "tauri build --bundles nsis,msi",
    "build:macos": "tauri build --bundles app,dmg",
    "build:linux": "tauri build --bundles deb,rpm,appimage",
    "test": "bun test src",
    "format:ts": "bun fmt --single-quote \"src/**/*.ts\"",
    "format:css": "bun fmt \"src/**/*.css\"",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@tauri-apps/cli": "^2.0.0",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.0"
  }
}
