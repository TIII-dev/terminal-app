{
  "name": "tiii-terminal-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "ng serve",
    "build:frontend": "ng build",
    "build:windows": "tauri build --bundles nsis,msi -- --locked",
    "build:macos": "tauri build --bundles app,dmg -- --locked",
    "build:linux": "tauri build --bundles deb,rpm,appimage -- --locked",
    "build:last-tag": "bun scripts/build-last-tagged-version/build-last-tagged-version.ts",
    "publish:last-tag": "bun scripts/publish-last-tagged-version/publish-last-tagged-version.ts",
    "release:patch": "gith release --patch --update-version --npm",
    "release:minor": "gith release --minor --update-version --npm",
    "release:major": "gith release --major --update-version --npm",
    "version": "bun scripts/release/release.version.ts",
    "install:linux": "bash scripts/install-linux.sh",
    "install:linux:arch": "npm run install:linux",
    "test": "bun test src scripts",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "format:ts": "bun fmt --single-quote \"src/**/*.ts\" \"scripts/**/*.ts\"",
    "format:css": "bun fmt \"src/**/*.css\"",
    "format:rs": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "tauri dev"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@tauri-apps/api": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@tauri-apps/cli": "^2.0.0",
    "@tertium/gith": "^0.5.0",
    "@types/bun": "^1.4.4",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "typescript": "~6.0.0"
  }
}
