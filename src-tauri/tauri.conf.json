{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TIIIErminal",
  "version": "0.1.0",
  "identifier": "app.tiii.terminal",
  "build": { "beforeDevCommand": "bun run dev", "devUrl": "http://localhost:4200", "beforeBuildCommand": "bunx --no-install ng build", "frontendDist": "../dist/tiii-terminal-app/browser" },
  "app": { "windows": [{ "title": "TIIIErminal", "decorations": false, "transparent": true, "windowEffects": { "effects": ["acrylic", "underWindowBackground"], "state": "active" }, "width": 1100, "height": 720, "minWidth": 640, "minHeight": 420 }], "security": { "csp": null } },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
